# PostgreSQL connection string.
# Local development against the PostgreSQL 17 instance on this machine:
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/marcostech?schema=public"

# Session signing secret. Generate a new one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="CHANGE_ME"

# Public base URL, used to build the QR tracking link printed on receipts.
APP_URL="http://localhost:3000"

# Vercel Blob token for repair photo storage.
# Leave empty in local development to fall back to on-disk storage under
# .local-blob/ (see src/shared/infrastructure/storage).
BLOB_READ_WRITE_TOKEN=""
